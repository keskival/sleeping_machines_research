   ]
  },
  "s5_analysis": {
   "owner": "any",
   "kind": "paired bootstrap, decision rule, operational metrics, sanity controls, generated table+figure, scoreboard line",
   "output": "experiments/results/fas/fas_v2_confirmatory_verdict_20261005T143000Z.json",
   "requires": [
    "s2_classical_test",
    "s4_confirm_native",
    "s4_confirm_references"
   ]
  },
  "s6_real_data": {
   "owner": "review host then curie/AWS",
   "kind": "HDFS (Loghub) or BPIC identity-stripped track; admit only if oracle minus best classical >= 0.05 on validation; freeze addendum first",
   "requires": [
    "s5_analysis"
   ]
  }
 }
